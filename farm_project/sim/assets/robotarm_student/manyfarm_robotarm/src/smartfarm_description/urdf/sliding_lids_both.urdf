  <joint name="transport_lid_mount" type="fixed">
    <parent link="world" />
    <child link="transport_lid_fixed" />
    <origin xyz="0.35 0 0.25" rpy="0 0 0" />
  </joint>
  <joint name="transport_lid_pinion_joint" type="revolute">
    <parent link="transport_lid_fixed" />
    <child link="transport_lid_gear" />
    <origin xyz="0 0 -0.074" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="2.5833333333333335" effort="1" velocity="0.5" />
  </joint>
  <joint name="transport_lid_plus_joint" type="prismatic">
    <parent link="transport_lid_fixed" />
    <child link="transport_lid_plus" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.155" effort="1" velocity="0.5" />
    <mimic joint="transport_lid_pinion_joint" multiplier="0.06" offset="0" />
  </joint>
  <joint name="transport_lid_minus_joint" type="prismatic">
    <parent link="transport_lid_fixed" />
    <child link="transport_lid_minus" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0" upper="0.155" effort="1" velocity="0.5" />
    <mimic joint="transport_lid_pinion_joint" multiplier="0.06" offset="0" />
  </joint>
