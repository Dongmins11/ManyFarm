  <joint name="transport_lid_mount" type="fixed">
    <parent link="cargo_box" />
    <child link="lid_drive_mount" />
    <origin xyz="-0.15 0 0.195" rpy="0 0 0" />
  </joint>
  <joint name="lid_pinion_joint" type="revolute">
    <parent link="lid_drive_mount" />
    <child link="lid_pinion" />
    <origin xyz="0 0 -0.074" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="2.5833333333333335" effort="1" velocity="0.5" />
  </joint>
  <joint name="top_lid_left_joint" type="prismatic">
    <parent link="lid_drive_mount" />
    <child link="top_lid_left" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0.155" effort="1" velocity="0.5" />
    <mimic joint="lid_pinion_joint" multiplier="0.06" offset="0" />
  </joint>
  <joint name="top_lid_right_joint" type="prismatic">
