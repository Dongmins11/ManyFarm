          <mesh filename="${mesh_root}/sliding_lids_v3/harvest/reference_horn.stl" scale=".001 .001 .001" />
        </geometry>
      </collision>
    </link>
    <joint name="harvest_lid_mount" type="fixed">
      <parent link="harvest_box" />
      <child link="harvest_lid_fixed" />
      <origin xyz="0 0 -0.006" rpy="0 0 0" />
    </joint>
    <joint name="harvest_lid_pinion_joint" type="revolute">
      <parent link="harvest_lid_fixed" />
      <child link="harvest_lid_gear" />
      <origin xyz="0 0 0.094" rpy="0 0 0" />
      <axis xyz="-1 0 0" />
      <limit lower="0" upper="2.5" effort="1" velocity="0.5" />
      <mimic joint="box_bottom_left_joint" multiplier="23.809523809523807" offset="0" />
    </joint>
    <joint name="box_bottom_left_joint" type="prismatic">
      <parent link="harvest_lid_fixed" />
      <child link="box_bottom_left" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <limit lower="0" upper="0.105" effort="1" velocity="0.5" />
    </joint>
    <joint name="box_bottom_right_joint" type="prismatic">
      <parent link="harvest_lid_fixed" />
      <child link="box_bottom_right" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="0 -1 0" />
      <limit lower="0" upper="0.105" effort="1" velocity="0.5" />
      <mimic joint="box_bottom_left_joint" multiplier="1" offset="0" />
    </joint>
  </xacro:macro>
</robot>