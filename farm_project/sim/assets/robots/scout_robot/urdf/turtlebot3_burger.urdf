<?xml version="1.0" ?>
<robot name="turtlebot3_burger"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- <xacro:include filename="$(find turtlebot3_description)/urdf/common_properties.urdf"/> -->

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <!-- Init colour -->
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="${namespace}base_footprint"/>

  <joint name="${namespace}base_joint" type="fixed">
    <parent link="${namespace}base_footprint"/>
    <child link="${namespace}base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/bases/burger_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.032 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.143"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="8.2573504e-01"/>
      <inertia ixx="2.2124416e-03" ixy="-1.2294101e-05" ixz="3.4938785e-05" iyy="2.1193702e-03" iyz="-5.0120904e-06" izz="2.0064271e-03" />
    </inertial>
  </link>

  <joint name="${namespace}wheel_left_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_left_link"/>
    <origin xyz="0.0 0.08 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>

  <joint name="${namespace}wheel_right_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_right_link"/>
    <origin xyz="0.0 -0.080 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09" iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05" />
    </inertial>
  </link>

  <joint name="${namespace}caster_back_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="${namespace}caster_back_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>

  <joint name="${namespace}imu_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}imu_link"/>

  <joint name="${namespace}scan_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}base_scan"/>
    <origin xyz="-0.032 0 0.172" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
    </inertial>
  </link>


  <!-- SCOUT-MOUNT-20261013: PDF 장착 기준. 추가 질량/관성 미정; 동역학 검증 모델 아님. -->
<link name="${namespace}scout_plate_center_ground" />
  <joint name="${namespace}scout_plate_center_ground_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_plate_center_ground" />
    <origin xyz="-0.032 0 0" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_mast_base" />
  <joint name="${namespace}scout_mast_base_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_mast_base" />
    <origin xyz="-0.032 0 0.200" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_mast_top" />
  <joint name="${namespace}scout_mast_top_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_mast_top" />
    <origin xyz="-0.032 0 0.620" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_mast_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.050 0.050 0.420" />
      </geometry>
      <material name="white" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.050 0.050 0.420" />
      </geometry>
    </collision>
  </link>
  <joint name="${namespace}scout_mast_link_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_mast_link" />
    <origin xyz="-0.032 0 0.410" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_top_plate_envelope">
    <!-- 근사 외곽 시각화만: 실제 Burger 판 메시/홀 패턴 미제공. 충돌체 아님. -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.13755 0.13755 0.009" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>
  <joint name="${namespace}scout_top_plate_envelope_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_top_plate_envelope" />
    <origin xyz="-0.032 0 0.1955" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_holder_reference">
    <!-- DUX 근사 외형: 중앙 51mm 개구와 두께 3mm. 체결 구멍/CAD 형상/충돌 미검증. -->
    <visual>
      <origin xyz="0 -0.027 0" rpy="0 0 0" />
      <geometry>
        <box size="0.137 0.003 0.050" />
      </geometry>
      <material name="grey" />
    </visual>
    <visual>
      <origin xyz="0 0.027 0" rpy="0 0 0" />
      <geometry>
        <box size="0.137 0.003 0.050" />
      </geometry>
      <material name="grey" />
    </visual>
    <visual>
      <origin xyz="-0.027 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.003 0.137 0.050" />
      </geometry>
      <material name="grey" />
    </visual>
    <visual>
      <origin xyz="0.027 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.003 0.137 0.050" />
      </geometry>
      <material name="grey" />
    </visual>
  </link>
  <joint name="${namespace}scout_holder_reference_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_holder_reference" />
    <origin xyz="-0.032 0 0.225" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_extension_post_1">
    <!-- 대변 5mm 육각봉의 외접 원통 시각화. 길이/축은 PDF B값. -->
    <visual>
      <geometry>
        <cylinder radius="0.002886751346" length="0.0395" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <joint name="${namespace}scout_extension_post_1_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_extension_post_1" />
    <origin xyz="-0.096000 -0.024000 0.17125" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_extension_post_2">
    <!-- 대변 5mm 육각봉의 외접 원통 시각화. 길이/축은 PDF B값. -->
    <visual>
      <geometry>
        <cylinder radius="0.002886751346" length="0.0395" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <joint name="${namespace}scout_extension_post_2_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_extension_post_2" />
    <origin xyz="-0.096000 0.024000 0.17125" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_extension_post_3">
    <!-- 대변 5mm 육각봉의 외접 원통 시각화. 길이/축은 PDF B값. -->
    <visual>
      <geometry>
        <cylinder radius="0.002886751346" length="0.0395" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <joint name="${namespace}scout_extension_post_3_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_extension_post_3" />
    <origin xyz="-0.008000 -0.064000 0.17125" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_extension_post_4">
    <!-- 대변 5mm 육각봉의 외접 원통 시각화. 길이/축은 PDF B값. -->
    <visual>
      <geometry>
        <cylinder radius="0.002886751346" length="0.0395" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <joint name="${namespace}scout_extension_post_4_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_extension_post_4" />
    <origin xyz="-0.008000 0.064000 0.17125" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_extension_post_5">
    <!-- 대변 5mm 육각봉의 외접 원통 시각화. 길이/축은 PDF B값. -->
    <visual>
      <geometry>
        <cylinder radius="0.002886751346" length="0.0395" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <joint name="${namespace}scout_extension_post_5_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_extension_post_5" />
    <origin xyz="0.032000 -0.024000 0.17125" rpy="0 0 0" />
  </joint>
  <link name="${namespace}scout_extension_post_6">
    <!-- 대변 5mm 육각봉의 외접 원통 시각화. 길이/축은 PDF B값. -->
    <visual>
      <geometry>
        <cylinder radius="0.002886751346" length="0.0395" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <joint name="${namespace}scout_extension_post_6_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}scout_extension_post_6" />
    <origin xyz="0.032000 0.024000 0.17125" rpy="0 0 0" />
  </joint>
  <link name="${namespace}bmany_camera_link">
    <!-- 원점=RGB 렌즈 중심. 외형은 렌즈 뒤에 놓은 개략 상자이며 렌즈-하우징 중심 변환은 미측정. pitch=1도/roll=0 잠정값. -->
    <visual>
      <origin xyz="-0.012525 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.02505 0.090 0.025" />
      </geometry>
      <material name="light_black" />
    </visual>
  </link>
  <joint name="${namespace}bmany_camera_link_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}bmany_camera_link" />
    <origin xyz="-0.049 0.055 0.595" rpy="0 0.017453292520 1.570796326795" />
  </joint>
  <link name="${namespace}camera_color_optical_frame" />
  <joint name="${namespace}camera_color_optical_frame_mount_joint" type="fixed">
    <parent link="${namespace}bmany_camera_link" />
    <child link="${namespace}camera_color_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795" />
  </joint>
  <link name="${namespace}camera_optical_frame" />
  <joint name="${namespace}camera_optical_frame_mount_joint" type="fixed">
    <parent link="${namespace}camera_color_optical_frame" />
    <child link="${namespace}camera_optical_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="${namespace}picam_frame">
    <!-- 렌즈 중심 기준. 판 중심 X=0은 PDF C값. 스트리밍 활성화와 무관한 외형/TF. -->
    <visual>
      <origin xyz="-0.004 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.008 0.025 0.024" />
      </geometry>
      <material name="green" />
    </visual>
  </link>
  <joint name="${namespace}picam_frame_mount_joint" type="fixed">
    <parent link="${namespace}base_footprint" />
    <child link="${namespace}picam_frame" />
    <origin xyz="-0.032 0.063 0.117" rpy="0 0 1.570796326795" />
  </joint>
  <link name="${namespace}picam_optical_frame" />
  <joint name="${namespace}picam_optical_frame_mount_joint" type="fixed">
    <parent link="${namespace}picam_frame" />
    <child link="${namespace}picam_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795" />
  </joint>

</robot>
