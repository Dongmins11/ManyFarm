<?xml version="1.0"?>
<package format="3">
  <name>farm_navigation</name><version>0.1.0</version>
  <description>Common navigation library for simulation and real robots</description>
  <maintainer email="maintainer@example.com">Farm Team</maintainer><license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend><exec_depend>action_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend><exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
